# Primary model (OpenAI-compatible). Local Ollama example:
MODEL_BASE_URL=http://localhost:11434/v1
MODEL_API_KEY=ollama
MODEL_NAME=qwen3:8b
MODEL_TIMEOUT=90

# Optional fallback when local is down. OpenRouter example:
FALLBACK_BASE_URL=https://openrouter.ai/api/v1
FALLBACK_API_KEY=
FALLBACK_MODEL=openrouter/free

# OpenRouter extras (ignored by Ollama)
OPENROUTER_HTTP_REFERER=https://github.com/longplay
OPENROUTER_TITLE=longplay

# Spotify Web API — client credentials (catalog search, no user OAuth)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
